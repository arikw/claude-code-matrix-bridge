# rx-claude-matrix-bridge — runtime config
# Location: ~/.config/rx-claude-matrix-bridge/config.env  (chmod 0600)
#
# Use bin/mx-setup to populate this file interactively. The wizard
# preserves any non-wizard-managed lines (comments, blanks, optional
# knobs in the section at the bottom) when re-run.

# ---------- required: Matrix ----------

# Matrix homeserver base URL (no trailing slash)
MATRIX_HOMESERVER=https://matrix.example.org

# Matrix user the bridge logs in as (the bot)
MATRIX_USER_ID=@yourbot:example.org

# Long-lived access token for MATRIX_USER_ID. Treat as a password.
MATRIX_ACCESS_TOKEN=replace-me

# The human operator (you). Only messages from this user are relayed
# into Claude. Auto-join only fires for invites sent by this user.
MATRIX_OWNER=@you:example.org

# ---------- optional knobs ----------
#
# Re-running bin/mx-setup preserves any keys not in the mandatory four
# above, so feel free to add your own tunables here. Comments and blank
# lines are preserved too.

# Matrix /createRoom preset used when link_chat creates a new room.
# Allowed: trusted_private_chat (default), private_chat, public_chat.
# MX_ROOM_PRESET=trusted_private_chat

# --permission-mode passed to `claude --print --resume` when the daemon
# falls back to a headless turn (i.e., the linked TUI is offline). Live
# TUI turns are unaffected by this — they use whatever permission mode
# the TUI was launched with.
#
# Allowed: default | acceptEdits | plan | bypassPermissions
#
# ⚠ bypassPermissions removes ALL tool-permission prompts for matrix-
#   triggered headless turns. Anyone who controls the MATRIX_OWNER
#   account can run Bash/Edit/Write on this host without confirmation.
#
# MX_CLAUDE_PERMISSION_MODE=default
